{
  "manifest_version": 3,
  "name": "VISTRA Assistant",
  "version": "0.1.0",
  "description": "Cited answers, a ghost cursor that shows you where to click, and page understanding on the sites you enable.",
  "minimum_chrome_version": "116",
  "action": { "default_popup": "popup.html", "default_title": "VISTRA" },
  "options_page": "options.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "optional_host_permissions": ["<all_urls>"],
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
