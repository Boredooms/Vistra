{
  "name": "@boredooms/vistra-sdk",
  "version": "0.1.0",
  "description": "Browser SDK for VISTRA: cited answers, guided walkthroughs with a visible cursor, and approved, verified actions.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "keywords": ["ai", "assistant", "sdk", "rag", "agent", "vistra"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --target es2022",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" }
    }
  },
  "dependencies": {
    "@boredooms/vistra-ghost-cursor": "workspace:^"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
